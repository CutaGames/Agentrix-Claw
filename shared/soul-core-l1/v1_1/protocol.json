  "profiles": [
    "personal-primary",
    "recovery-guardian",
    "operator-policy-admin",
    "governance-member",
    "finance-approver",
    "developer-test",
    "resident-executor"
  ],
  "proposalTypes": [
    "session_issue",
    "policy_update",
    "step_up",
    "freeze",
    "rotate",
    "recover",
    "governance",
    "finance",
    "retire"
