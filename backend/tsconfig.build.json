{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmitOnError": false
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.integration.spec.ts",
    "src/**/*.e2e.spec.ts",
    "src/test-*.ts",
    "src/scripts/test-*.ts",
    "src/modules/x402/**/*"
  ]
}
