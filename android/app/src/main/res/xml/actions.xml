<?xml version="1.0" encoding="utf-8"?>
<!--
  Android App Actions — mobile-prd-v3 section 10.3 (V3 core 6) plus
  mobile-prd-v4 section 8 (V4 plus 3 = 9 total).

  Surfaces 9 intents to Google Assistant / Search via the App Actions
  framework. Equivalent to iOS App Intents (ios/AgentrixIntents/*.swift).

  How it works:
    1. intentName : built-in Google intent (actions.intent.*) or custom.
    2. urlTemplate: agentrix://intent/NAME deep link with optional params.
    3. parameter-mapping: links semantic slots from the intent to URL params.
  At runtime Google Assistant fires the deep link, handleDeepLink parses it,
  and dispatchIntent routes to the right JS handler in
  src/services/intents/defaultIntentHandlers.ts.

  Wiring requirements:
    1. AndroidManifest.xml &lt;application&gt; already has:
         &lt;meta-data android:name="com.google.android.actions"
                    android:resource="@xml/actions" /&gt;
    2. App.tsx calls attachLinkingListener at boot.
    3. installDefaultIntentHandlers(navigationRef) installs JS handlers.

  Built-in intents docs:
    https://developer.android.com/guide/app-actions/built-in-intents

  Vendor portals (国内厂商 same deep-link contract reused):
    https://xiaoai.mi.com/dev                 — 小米 Xiao AI
    https://developer.huawei.com/consumer     — 华为小艺 / 鸿蒙意图
    https://open.oppomobile.com/              — OPPO 小布
    https://dev.vivo.com.cn/                  — vivo Jovi

  NOTE: XML comments must NOT contain a double-hyphen (two minus signs in a
  row). Android's resource compiler rejects the file outright if they do.
  Use plain prose instead of dashed dividers.
-->
<actions>

  <!-- ====== V3 Core 6 (P0 shipped 2026-05-04) ====== -->

  <!-- 1. Ask Aira (general Q&amp;A) -->
  <action intentName="actions.intent.GET_THING">
    <action-display
      labelTemplate="@string/aa_ask_aira_label"
      icon="@mipmap/ic_launcher" />
    <fulfillment urlTemplate="agentrix://intent/ask-aira{?question}">
      <parameter-mapping
        intentParameter="thing.name"
        urlParameter="question" />
    </fulfillment>
  </action>

  <!-- 2. Draft (compose) -->
  <action intentName="actions.intent.CREATE_MESSAGE">
    <fulfillment urlTemplate="agentrix://intent/draft{?topic,style}">
      <parameter-mapping
        intentParameter="message.text"
        urlParameter="topic" />
    </fulfillment>
  </action>

  <!-- 3. Approve (custom intent) -->
  <action intentName="custom.actions.intent.APPROVE">
    <fulfillment urlTemplate="agentrix://intent/approve{?approvalId}" />
    <parameter name="approvalId" type="https://schema.org/Text" />
  </action>

  <!-- 4. Wallet status -->
  <action intentName="actions.intent.GET_ACCOUNT">
    <fulfillment urlTemplate="agentrix://intent/wallet-status" />
  </action>

  <!-- 5. Invoke Agent (custom) -->
  <action intentName="custom.actions.intent.INVOKE_AGENT">
    <fulfillment urlTemplate="agentrix://intent/invoke-agent{?agent,input}" />
    <parameter name="agent" type="https://schema.org/Text" required="true" />
    <parameter name="input" type="https://schema.org/Text" />
  </action>

  <!-- 6. Pet mood (custom) -->
  <action intentName="custom.actions.intent.PET_MOOD">
    <fulfillment urlTemplate="agentrix://intent/pet-mood" />
  </action>

  <!-- ====== V4 Additions (mobile-prd-v4 section 8 — shipped 2026-05-18) ====== -->

  <!-- 7. Create Pet, e.g. Hey Google, create a pet with Agentrix -->
  <action intentName="custom.actions.intent.CREATE_PET">
    <fulfillment urlTemplate="agentrix://intent/create-pet{?prompt}" />
    <parameter name="prompt" type="https://schema.org/Text" />
  </action>

  <!-- 8. Switch Skin, e.g. Hey Google, switch skin to Cat Girl -->
  <action intentName="custom.actions.intent.SWITCH_SKIN">
    <fulfillment urlTemplate="agentrix://intent/switch-skin{?skinName,skinId}" />
    <parameter name="skinName" type="https://schema.org/Text" />
    <parameter name="skinId" type="https://schema.org/Text" />
  </action>

  <!-- 9. Marketplace search, e.g. Hey Google, search Agentrix marketplace for Christmas skins -->
  <action intentName="custom.actions.intent.MARKET_SEARCH">
    <fulfillment urlTemplate="agentrix://intent/market-search{?query,category}" />
    <parameter name="query" type="https://schema.org/Text" required="true" />
    <parameter name="category" type="https://schema.org/Text" />
  </action>

</actions>
