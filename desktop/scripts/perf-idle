#!/bin/bash
# perf-idle — idle CPU / memory of Agentrix Desktop on macOS (E64, I-030).
#
# Stored without ".sh": the repository's root .gitignore ignores *.sh.
#
# Usage (the queue must be paused first, E63):
#   python3 <board>/bin/heavy.py gui desktop --minutes 15 --reason "perf idle"
#   desktop/scripts/perf-idle "/path/to/Agentrix Desktop.app" [seconds=60] [warmup=20]
#   python3 <board>/bin/heavy.py gui-done desktop
#
# What it does, read-only apart from starting and stopping the app:
#   1. notes which WebKit helper processes (WebContent / GPU / Networking) already exist;
#   2. starts the app in the background (`open -n -g`), waits `warmup` seconds;
#   3. over `seconds`, measures CPU from each process's accumulated CPU time
#      (start and end of the window, so the number is a true average, not ps's
#      decaying %cpu) and samples RSS every 2 s;
#   4. sends SIGTERM to the app and reports per process and in total.
# WebKit helpers are XPC services parented to launchd, so "the app's helpers" are
# the ones that appeared after the app started. Close Safari / other WebKit apps
# first, or the attribution can include their new helpers.
# Never logs in, never sends anything anywhere.
set -u
export LC_ALL=C

app=${1:?usage: perf-idle "/path/to/Agentrix Desktop.app" [seconds] [warmup]}
seconds=${2:-60}
warmup=${3:-20}
exe_name=$(/usr/libexec/PlistBuddy -c "Print :CFBundleExecutable" "$app/Contents/Info.plist" 2>/dev/null) || {
  echo "perf-idle: not an app bundle: $app" >&2
  exit 2
}
exe="$app/Contents/MacOS/$exe_name"

webkit_pids() {
  ps -axo pid=,command= | awk '/com\.apple\.WebKit\.(WebContent|GPU|Networking)/ && !/awk/ {print $1}' | sort -n
}

# "[[dd-]hh:]mm:ss.cc" -> centiseconds
cpu_cs() {
  ps -o time= -p "$1" 2>/dev/null | awk '{
    t=$1; d=0; if (index(t,"-")) { split(t,a,"-"); d=a[1]; t=a[2] }
    n=split(t,p,":"); s=0; for(i=1;i<=n;i++) s=s*60+p[i]; s+=d*86400; printf "%d", s*100
  }'
}

before=$(webkit_pids)
open -n -g "$app" || { echo "perf-idle: could not start the app" >&2; exit 2; }

main=""
for _ in $(seq 1 30); do
  main=$(pgrep -f -n "$exe" || true)
  [ -n "$main" ] && break
  sleep 1
done
[ -n "$main" ] || { echo "perf-idle: the app did not start" >&2; exit 2; }
sleep "$warmup"

helpers=$(comm -13 <(printf '%s\n' "$before") <(webkit_pids) | tr '\n' ' ')
pids="$main $helpers"

# macOS ships bash 3.2: no associative arrays, so parallel indexed arrays.
pid_list=($pids)
count=${#pid_list[@]}
cpu0=(); rss_sum=(); rss_n=(); name=()
for ((i = 0; i < count; i++)); do
  pid=${pid_list[$i]}
  cpu0[$i]=$(cpu_cs "$pid")
  rss_sum[$i]=0
  rss_n[$i]=0
  name[$i]=$(ps -o command= -p "$pid" 2>/dev/null | sed -E 's#.*/##; s/ .*//' | cut -c1-40)
done

ws=$(pgrep -x WindowServer | head -1)
ws0=0
[ -n "$ws" ] && ws0=$(cpu_cs "$ws")
t0=$(date +%s)
while [ $(( $(date +%s) - t0 )) -lt "$seconds" ]; do
  for ((i = 0; i < count; i++)); do
    rss=$(ps -o rss= -p "${pid_list[$i]}" 2>/dev/null | tr -d ' ')
    if [ -n "$rss" ]; then
      rss_sum[$i]=$(( ${rss_sum[$i]} + rss ))
      rss_n[$i]=$(( ${rss_n[$i]} + 1 ))
    fi
  done
  sleep 2
done
elapsed=$(( $(date +%s) - t0 ))

total_cpu=0
total_rss=0
printf '%-8s %-40s %10s %10s\n' pid process "cpu%1core" "rss_MB"
for ((i = 0; i < count; i++)); do
  pid=${pid_list[$i]}
  c1=$(cpu_cs "$pid")
  [ -n "$c1" ] || c1=${cpu0[$i]}
  dcs=$(( c1 - ${cpu0[$i]:-0} ))
  cpu=$(awk -v d="$dcs" -v e="$elapsed" 'BEGIN{ printf "%.2f", (d/100)/e*100 }')
  if [ "${rss_n[$i]}" -gt 0 ]; then
    rss=$(( ${rss_sum[$i]} / ${rss_n[$i]} / 1024 ))
  else
    rss=0
  fi
  printf '%-8s %-40s %10s %10s\n' "$pid" "${name[$i]}" "$cpu" "$rss"
  total_cpu=$(awk -v a="$total_cpu" -v b="$cpu" 'BEGIN{ printf "%.2f", a+b }')
  total_rss=$(( total_rss + rss ))
done
printf '%-8s %-40s %10s %10s\n' "" "TOTAL (${elapsed}s after ${warmup}s warm-up)" "$total_cpu" "$total_rss"
# Reference only (not in TOTAL): compositing a large transparent window costs
# WindowServer CPU, which belongs to the system, not to the app.
if [ -n "$ws" ]; then
  ws1=$(cpu_cs "$ws")
  ws_cpu=$(awk -v d="$(( ${ws1:-$ws0} - ws0 ))" -v e="$elapsed" 'BEGIN{ printf "%.2f", (d/100)/e*100 }')
  printf '%-8s %-40s %10s\n' "$ws" "WindowServer (reference)" "$ws_cpu"
fi
echo "load: $(sysctl -n vm.loadavg)"

kill -TERM "$main" 2>/dev/null
for _ in $(seq 1 10); do
  kill -0 "$main" 2>/dev/null || break
  sleep 1
done
kill -0 "$main" 2>/dev/null && echo "perf-idle: the app is still running (pid $main); quit it by hand" >&2
exit 0
